{
  "name": "aliziodev/laravel-midtrans",
  "description": "Laravel integration for the aliziodev/midtrans-php SDK: config, facades, verified webhook handling and typed payment events.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "midtrans",
    "payments",
    "payment-gateway",
    "webhook",
    "snap",
    "snap-bi",
    "qris"
  ],
  "authors": [
    {
      "name": "Aliziodev",
      "email": "support@aliziodev.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "aliziodev/midtrans-php": "^2.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.30",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Aliziodev\\LaravelMidtrans\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aliziodev\\LaravelMidtrans\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest --exclude-group=sandbox",
    "test:sandbox": "pest --group=sandbox",
    "sandbox:serve": "@php scripts/sandbox-serve.php",
    "test:coverage": "pest --coverage --coverage-clover=coverage.xml",
    "lint": "pint",
    "lint:test": "pint --test",
    "analyse": "phpstan analyse --memory-limit=512M",
    "qa": [
      "composer validate --strict",
      "@lint:test",
      "@analyse",
      "@test"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Aliziodev\\LaravelMidtrans\\MidtransServiceProvider"
      ],
      "aliases": {
        "Midtrans": "Aliziodev\\LaravelMidtrans\\Facades\\Midtrans",
        "SnapBi": "Aliziodev\\LaravelMidtrans\\Facades\\SnapBi"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
